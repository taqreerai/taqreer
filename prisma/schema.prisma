generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String         @id @default(cuid())
  supabaseUserId String?        @unique
  name           String?
  email          String         @unique
  emailVerified  DateTime?
  image          String?
  password       String?
  plan           String         @default("free")
  role           String         @default("user")
  language       String         @default("ar")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  projects       Project[]
  templates      Template[]
  brandKits      BrandKit[]
  folders        Folder[]
  accounts       Account[]
  sessions       Session[]
  subscriptions  Subscription[]
  usageEvents    UsageEvent[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id            String        @id @default(cuid())
  userId        String
  title         String
  type          String        @default("create")
  language      String        @default("ar")
  format        String        @default("16:9")
  tone          String        @default("formal")
  status        String        @default("draft")
  thumbnail     String?
  // Per-slide WebP thumbnails for the hover-scrub UI on the
  // dashboard and projects page. Ordered slide-1 → slide-N.
  // Populated on "Save project" via the puppeteer pipeline.
  thumbnailUrls String[]
  // Filter columns for /projects. Frozen on first generation —
  // not updated by regen / partial-regen / save (per product req).
  slideCount    Int?
  dominantColor String?
  // Color buckets the deck "identifies as" for the /projects swatch
  // picker. Multi-valued because a brand can mix multiple accents
  // AND because greyscale-only decks intentionally tag with BOTH
  // #000000 and #FFFFFF so they surface under either filter.
  // Derivation lives in `lib/project/derive-color-tags.ts`:
  //   • chromatic siblings (saturation > 0.15)  → take them all,
  //     drop b/w/grey in the same palette as chrome, not identity
  //   • all-greyscale palette → ["#000000", "#FFFFFF"]
  //   • empty palette (Claude-decides) → fall back to the
  //     generated manifest's theme.brand.colors; then last-resort
  //     ["#000000", "#FFFFFF"]
  // Frozen on first generation alongside slideCount /
  // dominantColor. Empty array == "not yet computed" (default).
  colorTags     String[]      @default([])
  // Evocative 2-3 word template-style name (e.g. "صحراء ذهبية",
  // "Royal Magenta"). Generated by a Claude Haiku call after the
  // main deck-generate manifest lands, frozen on first generation
  // alongside the other filter columns. Used as the default title
  // when the user clicks "Save copy as template" — the project's
  // own title is often private / specific ("Q4 Pitch — Client X")
  // and would be a poor template name; this is purely a brand-style
  // descriptor (palette + fonts) with no project-content leakage.
  // Null on legacy decks until the backfill script runs.
  templateName  String?
  isFavorite    Boolean       @default(false)
  folderId      String?
  templateId    String?
  brandKitId    String?
  aiPrompt      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder        Folder?       @relation(fields: [folderId], references: [id])
  presentation  Presentation?
  files         File[]
  jobs          Job[]

  @@index([userId, isFavorite])
}

model Presentation {
  id               String                @id @default(cuid())
  projectId        String                @unique
  currentVersionId String?
  // The PresentationVersion id this project was last "saved" at —
  // the canonical pinned snapshot used to source dashboard
  // thumbnails, /projects filter data, and template exports.
  // null until the user clicks "حفظ المشروع" for the first time.
  savedVersionId   String?
  // Per-slide content snapshot taken at save time: a JSON object
  // mapping slideKey → SlideState.currentVersionNumber. Necessary
  // because per-slide restore mutates PresentationVersion.slideJson
  // IN PLACE (see lib/db/slide-versioning.ts:spliceSlideIntoActive
  // Manifest) without bumping `currentVersionId`, so the
  // saved/unsaved indicator can't rely on the PresentationVersion
  // pointer alone — it also has to compare every slide's live
  // version pointer against this snapshot. Null whenever
  // savedVersionId is null (never saved).
  savedSlideVersions Json?
  title            String
  language         String                @default("ar")
  direction        String                @default("rtl")
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  project          Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions         PresentationVersion[]
  comments         Comment[]
  slideStates      SlideState[]
}

model PresentationVersion {
  id             String       @id @default(cuid())
  presentationId String
  versionNumber  Int
  slideJson      Json
  status         String       @default("completed")
  createdAt      DateTime     @default(now())
  presentation   Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  comments       Comment[]

  @@unique([presentationId, versionNumber])
}

// Per-slide metadata that survives across slide-content versions
// for the same logical slide (matched by `slideKey`, the stable
// id Claude assigns in the manifest). Carries the lock flag and
// the comment payload cache used by "Try again" on the per-slide
// pill.
model SlideState {
  id                   String         @id @default(cuid())
  presentationId       String
  slideKey             String
  currentVersionNumber Int            @default(1)
  // null = unlocked. When set, full-deck regen skips this slide
  // entirely (per-slide regen / undo still allowed — lock only
  // protects against bulk operations).
  lockedAt             DateTime?
  // Last-applied comment payload, JSON shape mirrors what
  // `deck-regenerate-partial` accepts. Replayed by "Try again".
  // Cleared on Lock, Regen (clean), or when fresh comments arrive.
  cachedComments       Json?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  presentation         Presentation   @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  versions             SlideVersion[]

  @@unique([presentationId, slideKey])
}

// Append-only per-slide history. Capped at 5 rows per SlideState
// (see MAX_VERSIONS_PER_SLIDE in lib/db/slide-versioning.ts) —
// oldest pruned on insert so the table can't grow unbounded even
// for heavy iteration. Locked versions are also pruneable (lock
// is a SlideState-level flag, not a version-level flag).
model SlideVersion {
  id            String     @id @default(cuid())
  slideStateId  String
  versionNumber Int
  slideJson     Json
  // create | regen | partial_regen | restore
  source        String     @default("create")
  createdAt     DateTime   @default(now())
  slideState    SlideState @relation(fields: [slideStateId], references: [id], onDelete: Cascade)

  @@unique([slideStateId, versionNumber])
  @@index([slideStateId, createdAt(sort: Desc)])
}

model File {
  id         String   @id @default(cuid())
  projectId  String
  type       String
  storageUrl String
  mimeType   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Comment {
  id             String              @id @default(cuid())
  presentationId String
  versionId      String
  slideId        String
  areaId         String?
  elementIds     String[]
  boundsJson     Json?
  screenshotUrl  String?
  content        String
  status         String              @default("draft")
  createdAt      DateTime            @default(now())
  presentation   Presentation        @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  version        PresentationVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([presentationId, versionId, status])
  @@index([slideId])
}

model Job {
  id                  String   @id @default(cuid())
  projectId           String?
  inngestRunId        String?  @unique
  type                String
  status              String   @default("queued")
  inputJson           Json?
  outputJson          Json?
  // Token-usage telemetry. Captured from Anthropic's `message.usage`
  // when the stream / non-streaming call completes. Accumulates across
  // retry attempts. Pre-credits-billing this is pure observability —
  // logs cost per flow / preset / model so the pricing structure can be
  // set from data once enhance + simulate land. Flat columns (not
  // outputJson) for cheap aggregate queries.
  model               String?
  quality             String?
  attempts            Int      @default(0)
  inputTokens         Int      @default(0)
  outputTokens        Int      @default(0)
  cacheReadTokens     Int      @default(0)
  cacheCreationTokens Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  project             Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

// A brand-only snapshot derived from a Project. Stripped of all content
// (titles, copy, logo) — keeps just palette + fonts + layout style so it
// can be re-applied to a new deck. Rendered as 4 showcase PNGs (cover /
// typography / palette / layout sample) via Puppeteer at save time.
//
// `brand` is a structured snapshot of the brand attributes; see
// `lib/template/derive-brand.ts` for the exact shape and how it's built
// from a Project's latest completed manifest.
//
// `sourceProjectId` is a non-FK pointer back to the originating Project
// for provenance ("which deck did this template come from?"). Not a true
// FK because the source project may be deleted later and we want the
// template to keep working — null-on-delete via app logic, not DB.
//
// `publishedAt` is set when isPublic flips to true (and cleared if it
// flips back). Used to order the public templates feed by recency
// independent of createdAt (a user may sit on a private template for
// weeks before publishing).
model Template {
  id              String    @id @default(cuid())
  ownerId         String
  title           String
  language        String    @default("ar")
  direction       String    @default("rtl")
  slideCount      Int       @default(3)
  brand           Json      @default("{}")
  sourceProjectId String?
  thumbnailUrls   String[]
  useCount        Int       @default(0)
  isPublic        Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  owner           User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([isPublic, publishedAt(sort: Desc)])
  @@index([ownerId, createdAt(sort: Desc)])
}

model BrandKit {
  id        String   @id @default(cuid())
  userId    String
  name      String
  logo      String?
  colors    Json?
  fonts     Json?
  aiTone    String?
  assetUrls Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Folder {
  id        String    @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects  Project[]
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String
  stripeCustomerId String?   @unique
  plan             String    @default("free")
  status           String    @default("active")
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UsageEvent {
  id        String   @id @default(cuid())
  userId    String
  eventType String
  amount    Int      @default(1)
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
