generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String         @id @default(cuid())
  supabaseUserId String?        @unique
  name           String?
  email          String         @unique
  emailVerified  DateTime?
  image          String?
  password       String?
  plan           String         @default("free")
  role           String         @default("user")
  language       String         @default("ar")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  projects       Project[]
  templates      Template[]
  brandKits      BrandKit[]
  folders        Folder[]
  accounts       Account[]
  sessions       Session[]
  subscriptions  Subscription[]
  usageEvents    UsageEvent[]
  projectShares  ProjectShare[]
  comments       Comment[]
  // Notifications addressed TO this user (recipientUserId). The
  // `notificationsActed` back-relation tracks rows where this user
  // is the actor (someone else's bell entries). Kept separate so
  // a single inverse query reads cleanly.
  notifications      Notification[] @relation("RecipientNotifications")
  notificationsActed Notification[] @relation("ActorNotifications")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id            String        @id @default(cuid())
  userId        String
  title         String
  type          String        @default("create")
  language      String        @default("ar")
  format        String        @default("16:9")
  tone          String        @default("formal")
  status        String        @default("draft")
  thumbnail     String?
  // Per-slide WebP thumbnails for the hover-scrub UI on the
  // dashboard and projects page. Ordered slide-1 → slide-N.
  // Populated on "Save project" via the puppeteer pipeline.
  thumbnailUrls String[]
  // Filter columns for /projects. Frozen on first generation —
  // not updated by regen / partial-regen / save (per product req).
  slideCount    Int?
  dominantColor String?
  // Color buckets the deck "identifies as" for the /projects swatch
  // picker. Multi-valued because a brand can mix multiple accents
  // AND because greyscale-only decks intentionally tag with BOTH
  // #000000 and #FFFFFF so they surface under either filter.
  // Derivation lives in `lib/project/derive-color-tags.ts`:
  //   • chromatic siblings (saturation > 0.15)  → take them all,
  //     drop b/w/grey in the same palette as chrome, not identity
  //   • all-greyscale palette → ["#000000", "#FFFFFF"]
  //   • empty palette (Claude-decides) → fall back to the
  //     generated manifest's theme.brand.colors; then last-resort
  //     ["#000000", "#FFFFFF"]
  // Frozen on first generation alongside slideCount /
  // dominantColor. Empty array == "not yet computed" (default).
  colorTags     String[]      @default([])
  // Evocative 2-3 word template-style name (e.g. "صحراء ذهبية",
  // "Royal Magenta"). Generated by a Claude Haiku call after the
  // main deck-generate manifest lands, frozen on first generation
  // alongside the other filter columns. Used as the default title
  // when the user clicks "Save copy as template" — the project's
  // own title is often private / specific ("Q4 Pitch — Client X")
  // and would be a poor template name; this is purely a brand-style
  // descriptor (palette + fonts) with no project-content leakage.
  // Null on legacy decks until the backfill script runs.
  templateName  String?
  isFavorite    Boolean       @default(false)
  folderId      String?
  templateId    String?
  brandKitId    String?
  brandKit      BrandKit?     @relation(fields: [brandKitId], references: [id], onDelete: SetNull)
  aiPrompt      String?
  // Share state. Phase 15.1 (2026-05-23).
  //
  // `publicAccessLevel` enables "anyone with the link" semantics —
  // null means the link is private (owner + per-invitee shares
  // only). When set, any authenticated user reading via the public
  // route gets at most that role (`view` / `comment` / `edit`).
  // Anonymous (signed-out) callers cap at `view`, never above —
  // enforced server-side, not from the column.
  //
  // `hideBrandingBadge` is a paid-tier toggle for white-labelling
  // the embedded preview chrome. Field exists from day one so the
  // share modal can show/disable the control behind a future
  // entitlement check.
  publicAccessLevel ProjectAccessLevel?
  hideBrandingBadge Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder        Folder?       @relation(fields: [folderId], references: [id])
  presentation  Presentation?
  files         File[]
  jobs          Job[]
  shares        ProjectShare[]
  notifications Notification[]

  @@index([userId, isFavorite])
}

// "Anyone with the link" + per-invitee role on a Project. Three
// levels: read-only (`view`), can comment (`comment`), and full
// edit (`edit`). `edit` triggers auto-clone on accept — the
// invitee gets their OWN copy of the deck, not a shared editable
// pointer; see /invitations/[token]/accept handler.
enum ProjectAccessLevel {
  view
  comment
  edit
}

// Per-invitee share row. Created on owner action via
// POST /api/projects/[id]/share; resolved (userId populated,
// acceptedAt stamped) when the invitee opens the invite URL +
// matches the token to their logged-in email. `inviteToken` is
// the one-time URL component (`/invitations/[token]/accept`)
// emailed via Resend; nullable because revoked rows keep the
// historical row but drop the token to prevent re-acceptance.
model ProjectShare {
  id           String              @id @default(cuid())
  projectId    String
  email        String
  // Resolved on accept. Stays null until the invitee actually
  // opens the invite URL — bare invites without a matching
  // Supabase account still surface in the share modal but have
  // no user yet.
  userId       String?
  accessLevel  ProjectAccessLevel
  // The owner's User.id at invite time. Distinct from
  // Project.userId so audit trails survive an ownership transfer
  // (a feature we don't have yet — preserves the option).
  invitedBy    String
  invitedAt    DateTime            @default(now())
  acceptedAt   DateTime?
  // Owner-revoked timestamp. Soft-delete: the row stays after
  // a revoke so the access resolver can DENY the recipient on
  // subsequent requests (otherwise a project with
  // `publicAccessLevel = "view"` would let the kicked user fall
  // through to the public-link view — user direction 2026-05-26
  // "revoked user still can access through the link"). Re-inviting
  // the same email resets `revokedAt` to null in the share-POST
  // upsert path. List queries (share modal, GET /api/projects/[id]/
  // share) filter `revokedAt: null` so revoked rows don't surface.
  revokedAt    DateTime?
  // One-time URL token. Set on creation, nulled on revoke so a
  // stale email link can't grant access after the owner kicks
  // someone out. `@unique` enforces collision-free generation.
  inviteToken  String?             @unique
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // The user who accepted the invite — null until accept. Cascade
  // on user delete so we don't keep dangling rows pointing at
  // deleted accounts (the share's email field still preserves the
  // audit trail of "X was once invited" via the email column).
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Owner can have one row per invitee — re-inviting the same
  // email upserts (changes accessLevel) rather than stacking
  // rows.
  @@unique([projectId, email])
  @@index([userId])
}

model Presentation {
  id               String                @id @default(cuid())
  projectId        String                @unique
  currentVersionId String?
  // The PresentationVersion id this project was last "saved" at —
  // the canonical pinned snapshot used to source dashboard
  // thumbnails, /projects filter data, and template exports.
  // null until the user clicks "حفظ المشروع" for the first time.
  savedVersionId   String?
  // Per-slide content snapshot taken at save time: a JSON object
  // mapping slideKey → SlideState.currentVersionNumber. Necessary
  // because per-slide restore mutates PresentationVersion.slideJson
  // IN PLACE (see lib/db/slide-versioning.ts:spliceSlideIntoActive
  // Manifest) without bumping `currentVersionId`, so the
  // saved/unsaved indicator can't rely on the PresentationVersion
  // pointer alone — it also has to compare every slide's live
  // version pointer against this snapshot. Null whenever
  // savedVersionId is null (never saved).
  savedSlideVersions Json?
  title            String
  language         String                @default("ar")
  direction        String                @default("rtl")
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  project          Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions         PresentationVersion[]
  comments         Comment[]
  slideStates      SlideState[]
}

model PresentationVersion {
  id             String       @id @default(cuid())
  presentationId String
  versionNumber  Int
  slideJson      Json
  status         String       @default("completed")
  createdAt      DateTime     @default(now())
  presentation   Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  comments       Comment[]

  @@unique([presentationId, versionNumber])
}

// Per-slide metadata that survives across slide-content versions
// for the same logical slide (matched by `slideKey`, the stable
// id Claude assigns in the manifest). Carries the lock flag and
// the comment payload cache used by "Try again" on the per-slide
// pill.
model SlideState {
  id                   String         @id @default(cuid())
  presentationId       String
  slideKey             String
  currentVersionNumber Int            @default(1)
  // null = unlocked. When set, full-deck regen skips this slide
  // entirely (per-slide regen / undo still allowed — lock only
  // protects against bulk operations).
  lockedAt             DateTime?
  // Last-applied comment payload, JSON shape mirrors what
  // `deck-regenerate-partial` accepts. Replayed by "Try again".
  // Cleared on Lock, Regen (clean), or when fresh comments arrive.
  cachedComments       Json?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  presentation         Presentation   @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  versions             SlideVersion[]

  @@unique([presentationId, slideKey])
}

// Append-only per-slide history. Capped at 5 rows per SlideState
// (see MAX_VERSIONS_PER_SLIDE in lib/db/slide-versioning.ts) —
// oldest pruned on insert so the table can't grow unbounded even
// for heavy iteration. Locked versions are also pruneable (lock
// is a SlideState-level flag, not a version-level flag).
model SlideVersion {
  id            String     @id @default(cuid())
  slideStateId  String
  versionNumber Int
  slideJson     Json
  // create | regen | partial_regen | restore
  source        String     @default("create")
  createdAt     DateTime   @default(now())
  slideState    SlideState @relation(fields: [slideStateId], references: [id], onDelete: Cascade)

  @@unique([slideStateId, versionNumber])
  @@index([slideStateId, createdAt(sort: Desc)])
}

model File {
  id         String   @id @default(cuid())
  projectId  String
  type       String
  storageUrl String
  mimeType   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Comment {
  id             String              @id @default(cuid())
  presentationId String
  versionId      String
  slideId        String
  // Comment author. Set on create from the authenticated user (the
  // route looks up the prisma user via supabaseUserId). Nullable
  // because pre-existing rows from before Phase 15.B don't have an
  // author — we backfill on read by rendering "غير معروف" instead
  // of breaking the panel. New comments always have authorId set.
  authorId       String?
  areaId         String?
  elementIds     String[]
  boundsJson     Json?
  screenshotUrl  String?
  content        String
  status         String              @default("draft")
  createdAt      DateTime            @default(now())
  presentation   Presentation        @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  version        PresentationVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  // Set onDelete: SetNull so deleting an account preserves the
  // comment's content (slide review history still readable to the
  // owner) but anonymises the author row. Same policy ProjectShare
  // uses on its userId relation.
  author         User?               @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([presentationId, versionId, status])
  @@index([slideId])
  @@index([authorId])
}

model Job {
  id                  String   @id @default(cuid())
  projectId           String?
  inngestRunId        String?  @unique
  type                String
  status              String   @default("queued")
  inputJson           Json?
  outputJson          Json?
  // Token-usage telemetry. Captured from Anthropic's `message.usage`
  // when the stream / non-streaming call completes. Accumulates across
  // retry attempts. Pre-credits-billing this is pure observability —
  // logs cost per flow / preset / model so the pricing structure can be
  // set from data once enhance + simulate land. Flat columns (not
  // outputJson) for cheap aggregate queries.
  model               String?
  quality             String?
  attempts            Int      @default(0)
  inputTokens         Int      @default(0)
  outputTokens        Int      @default(0)
  cacheReadTokens     Int      @default(0)
  cacheCreationTokens Int      @default(0)
  // Mid-stream cancellation signal. Set to NOW() by
  // POST /api/projects/[id]/cancel when the user clicks the
  // cancel pill in the slide-nav. The deck-generate worker polls
  // this column after every closed slide in the streaming parser —
  // if non-null, it aborts the Anthropic stream + marks the
  // version/project cancelled. Inngest's `cancelOn` event handles
  // the BETWEEN-steps cancellation; this column handles the
  // INSIDE-step (mid-stream) abort.
  cancelRequestedAt   DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  project             Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

// A brand-only snapshot derived from a Project. Stripped of all content
// (titles, copy, logo) — keeps just palette + fonts + layout style so it
// can be re-applied to a new deck. Rendered as 4 showcase PNGs (cover /
// typography / palette / layout sample) via Puppeteer at save time.
//
// `brand` is a structured snapshot of the brand attributes; see
// `lib/template/derive-brand.ts` for the exact shape and how it's built
// from a Project's latest completed manifest.
//
// `sourceProjectId` is a non-FK pointer back to the originating Project
// for provenance ("which deck did this template come from?"). Not a true
// FK because the source project may be deleted later and we want the
// template to keep working — null-on-delete via app logic, not DB.
//
// `publishedAt` is set when isPublic flips to true (and cleared if it
// flips back). Used to order the public templates feed by recency
// independent of createdAt (a user may sit on a private template for
// weeks before publishing).
model Template {
  id              String    @id @default(cuid())
  ownerId         String
  title           String
  language        String    @default("ar")
  direction       String    @default("rtl")
  slideCount      Int       @default(3)
  brand           Json      @default("{}")
  sourceProjectId String?
  // Real-deck artifacts (v2 rework): the source project's deck rendered
  // to a multi-page PDF (the "layout") plus its real per-slide
  // thumbnails. `pdfUrl` is the public Supabase URL of the stored deck
  // PDF; it is re-uploaded to the Anthropic Files API at use-time
  // (file_ids expire) to become the Mimic flow's design reference. Null
  // until the render job completes.
  pdfUrl          String?
  thumbnailUrls   String[]
  useCount        Int       @default(0)
  isPublic        Boolean   @default(false)
  // Premium templates are gated to a paid plan (e.g. "pro"). Set only by
  // the platform/curator account; regular users' templates stay free.
  // Enforcement is wired with the subscription model — until then the
  // flag is display-only.
  isPremium       Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  owner           User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([isPublic, publishedAt(sort: Desc)])
  @@index([ownerId, createdAt(sort: Desc)])
}

model BrandKit {
  id        String   @id @default(cuid())
  userId    String
  name      String
  logo      String?
  colors    Json?
  fonts     Json?
  aiTone    String?
  assetUrls Json?
  // Marks this kit as the user's default — the four landing flows
  // (/create, /enhance, /mimic, /datasheet) auto-hydrate from the
  // default kit on first mount when no in-flight brand session
  // exists. At most one kit per user can be true.
  //
  // Invariant is enforced at the DB level by a partial unique index
  // `BrandKit_userId_default_unique` (migration
  // 20260528000127_brandkit_isdefault_partial_unique) — Postgres
  // partial unique indexes can't be expressed declaratively in
  // schema.prisma yet, so it lives in raw SQL. The API route still
  // does the two-step transaction (clear-others → flip-self) as
  // the happy-path mechanism; the partial unique index catches
  // concurrent set-default races and surfaces a Prisma P2002 error
  // the route translates into a 409 for the client.
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Reverse relation for Project.brandKitId. Configured `SetNull` on
  // delete so removing a brand kit doesn't cascade-destroy the
  // user's projects — the project's brand fields already live in
  // `aiPrompt`, the FK is just a pointer that becomes meaningless.
  projects  Project[]

  @@index([userId, isDefault])
}

model Folder {
  id        String    @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects  Project[]
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String
  stripeCustomerId String?   @unique
  plan             String    @default("free")
  status           String    @default("active")
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UsageEvent {
  id        String   @id @default(cuid())
  userId    String
  eventType String
  amount    Int      @default(1)
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Phase 16.E — bell notifications.
//
// One row per "X happened that the recipient should know about." Server-
// side fan-out (`lib/notifications/server.ts`) creates rows alongside
// the realtime broadcasts that already drive live UI; the bell consumes
// rows via REST + a per-user Supabase channel.
//
// `type` is a free-form string (not an enum) because new event kinds
// will be added incrementally; an enum would force a migration each
// time. The client maps `type` → renderer + icon via a small lookup
// table in BellDropdown. Unknown types are tolerated (renderer falls
// back to a generic info row using only `payload.title` if present).
//
// `payload` JSON shape is type-specific. Examples:
//   comment.created  { slideKey, commentId, slideIds: ["s1", "s2"] }
//     (slideIds populated when grouping merges multiple events from
//      the same actor on the same project within the group window)
//   slide.regen.finished { slideKey, slideIds: [...] }
//   deck.regen.finished  {}  (no extra info — message uses projectId)
//   deck.generate.finished { versionId }
//   deck.generate.failed   { reason? }
//   share.invited     { email, accessLevel }
//   share.accepted    {}
//
// `projectId` is nullable so account-scoped events (an invite to a
// project the recipient hasn't joined yet, etc.) can still write a
// row when needed. When set, ON DELETE Cascade so wiping a project
// also drops its notifications.
//
// `actorUserId` is nullable so system-generated events (a generation
// completing isn't "caused by" a peer) can still attribute the source
// in the JOIN even if no human actor exists. Drops to SET NULL on
// user delete so the notification survives the actor's account removal
// (the recipient may still want context like "the user who shared
// this with you has left").
//
// `readAt` is set in bulk when the user opens the bell — "mark all
// read on bell open" per product decision 2026-05-24. We do NOT do
// per-row read state (a click on a row navigates, doesn't toggle
// read).
//
// Indexes:
//   • (recipientUserId, createdAt desc)  — the bell's primary list
//     query, sorted newest-first.
//   • (recipientUserId, readAt)          — unread count for the
//     badge: `count where readAt IS NULL`.
model Notification {
  id              String   @id @default(cuid())
  recipientUserId String
  // Free-form discriminator. See top-of-model comment for the active
  // type set. New types added here are reflected in the bell renderer
  // lookup; unknown types render a generic row.
  type            String
  payload         Json
  // Optional foreign key — see top-of-model comment for the nullable
  // rationale. ON DELETE Cascade so deleting a project sweeps its
  // notifications. SET NULL would orphan rows that still reference a
  // dead projectId in the payload, which the renderer can't dereference.
  projectId       String?
  // Optional foreign key — see top-of-model comment for the nullable +
  // SET NULL rationale. The actor's display name + avatar live on
  // the User row that this points to (lazily joined by the bell's
  // GET route), so deleted-actor rows render with a generic
  // "someone" placeholder instead of a broken JOIN.
  actorUserId     String?
  createdAt       DateTime @default(now())
  readAt          DateTime?

  recipient User    @relation("RecipientNotifications", fields: [recipientUserId], references: [id], onDelete: Cascade)
  actor     User?   @relation("ActorNotifications", fields: [actorUserId], references: [id], onDelete: SetNull)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, createdAt(sort: Desc)])
  @@index([recipientUserId, readAt])
}
