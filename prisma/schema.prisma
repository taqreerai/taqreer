generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String         @id @default(cuid())
  supabaseUserId String?        @unique
  name           String?
  email          String         @unique
  emailVerified  DateTime?
  image          String?
  password       String?
  plan           String         @default("free")
  role           String         @default("user")
  language       String         @default("ar")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  // Admin ban (set by the admin console). Non-null = banned; blocks app access.
  bannedAt       DateTime?
  banReason      String?
  // Complimentary tier: an admin granted a paid tier for a fixed window (no
  // Stripe). Non-null = the tier is comped until this time; the daily
  // credits-maintenance cron reverts the user to free once it passes.
  planCompExpiresAt DateTime?
  // Signup forensics, stamped once at provisioning from Cloudflare headers
  // (cf-connecting-ip / cf-ipcountry / cf-ipcity) and backfilled for older
  // rows from the credit.grant.signup event metadata. Never updated after.
  signupIp       String?
  signupCountry  String? // ISO 3166-1 alpha-2
  signupCity     String? // decoded cf-ipcity (needs the CF visitor-location Managed Transform)
  // Invite-a-colleague (2026-10-04). referralCode: this user's own invite
  // code (minted lazily by /api/referral). referredById: who invited this
  // user (set once, at the signup grant). referralRewardedAt: when the
  // inviter got their reward for THIS user's first payment (idempotency).
  referralCode       String?   @unique
  referredById       String?
  referredBy         User?     @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals          User[]    @relation("Referrals")
  referralRewardedAt DateTime?
  projects       Project[]
  deckPurchases  DeckPurchase[]
  templates      Template[]
  brandKits      BrandKit[]
  folders        Folder[]
  subscriptions  Subscription[]
  usageEvents    UsageEvent[]
  creditAccount  CreditAccount?
  topupGrants    TopupGrant[]
  creditHolds    CreditHold[]
  projectShares  ProjectShare[]
  comments       Comment[]
  assistantMessages AssistantMessage[]
  // Notifications addressed TO this user (recipientUserId). The
  // `notificationsActed` back-relation tracks rows where this user
  // is the actor (someone else's bell entries). Kept separate so
  // a single inverse query reads cleanly.
  notifications      Notification[] @relation("RecipientNotifications")
  notificationsActed Notification[] @relation("ActorNotifications")
  flattenEvents      FlattenEvent[]
  exportEvents       ExportEvent[]

  @@index([referredById, referralRewardedAt])
}

model Project {
  id            String        @id @default(cuid())
  userId        String
  title         String
  type          String        @default("create")
  language      String        @default("ar")
  format        String        @default("16:9")
  tone          String        @default("formal")
  status        String        @default("draft")
  thumbnail     String?
  // Per-slide WebP thumbnails for the hover-scrub UI on the
  // dashboard and projects page. Ordered slide-1 → slide-N.
  // Populated on "Save project" via the puppeteer pipeline.
  thumbnailUrls String[]
  // Filter columns for /projects. Frozen on first generation —
  // not updated by regen / partial-regen / save (per product req).
  slideCount    Int?
  dominantColor String?
  // Color buckets the deck "identifies as" for the /projects swatch
  // picker. Multi-valued because a brand can mix multiple accents
  // AND because greyscale-only decks intentionally tag with BOTH
  // #000000 and #FFFFFF so they surface under either filter.
  // Derivation lives in `lib/project/derive-color-tags.ts`:
  //   • chromatic siblings (saturation > 0.15)  → take them all,
  //     drop b/w/grey in the same palette as chrome, not identity
  //   • all-greyscale palette → ["#000000", "#FFFFFF"]
  //   • empty palette (Claude-decides) → fall back to the
  //     generated manifest's theme.brand.colors; then last-resort
  //     ["#000000", "#FFFFFF"]
  // Frozen on first generation alongside slideCount /
  // dominantColor. Empty array == "not yet computed" (default).
  colorTags     String[]      @default([])
  isFavorite    Boolean       @default(false)
  folderId      String?
  templateId    String?
  brandKitId    String?
  brandKit      BrandKit?     @relation(fields: [brandKitId], references: [id], onDelete: SetNull)
  aiPrompt      String?
  // Share state. Phase 15.1 (2026-05-23).
  //
  // `publicAccessLevel` enables "anyone with the link" semantics —
  // null means the link is private (owner + per-invitee shares
  // only). When set, any authenticated user reading via the public
  // route gets at most that role (`view` / `comment` / `edit`).
  // Anonymous (signed-out) callers cap at `view`, never above —
  // enforced server-side, not from the column.
  //
  // `hideBrandingBadge` is a paid-tier toggle for white-labelling
  // the embedded preview chrome. Field exists from day one so the
  // share modal can show/disable the control behind a future
  // entitlement check.
  publicAccessLevel ProjectAccessLevel?
  hideBrandingBadge Boolean       @default(false)
  // Teaser paywall (free-tier conversion play). A free-tier `create`
  // deck is conceived as a 10-slide deck of which only the first 5
  // render; the last `teaserLockedCount` slides show blurred/locked in
  // the viewer and are NOT generated until the user subscribes. On
  // unlock we author the remaining slides on Opus (comped) and stamp
  // `teaserUnlockedAt`. Both are deck-level and stable across content
  // versions. 0 / null == a normal (non-teaser) deck. Set once at
  // creation from the creator's tier; never re-derived (so the deck
  // stays a teaser even if the owner later upgrades).
  teaserLockedCount Int           @default(0)
  teaserUnlockedAt  DateTime?
  // One-time "unlock this deck" purchase (2026-10-08): set when a free owner
  // buys this deck outright (DeckPurchase). Unlocks the teaser like a
  // subscription would and drops the free watermark for THIS deck only.
  // Cleared on refund (the unlocked slides stay).
  purchasedAt       DateTime?
  purchases         DeckPurchase[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder        Folder?       @relation(fields: [folderId], references: [id])
  presentation  Presentation?
  jobs          Job[]
  shares        ProjectShare[]
  assistantMessages AssistantMessage[]
  notifications Notification[]
  flattenEvents FlattenEvent[]
  exportEvents  ExportEvent[]

  @@index([userId, isFavorite])
  @@index([brandKitId])
  @@index([folderId])
}

// "Anyone with the link" + per-invitee role on a Project. Three
// levels: read-only (`view`), can comment (`comment`), and full
// edit (`edit`). `edit` triggers auto-clone on accept — the
// invitee gets their OWN copy of the deck, not a shared editable
// pointer; see /invitations/[token]/accept handler.
enum ProjectAccessLevel {
  view
  comment
  edit
}

// Per-invitee share row. Created on owner action via
// POST /api/projects/[id]/share; resolved (userId populated,
// acceptedAt stamped) when the invitee opens the invite URL +
// matches the token to their logged-in email. `inviteToken` is
// the one-time URL component (`/invitations/[token]/accept`)
// emailed via Resend; nullable because revoked rows keep the
// historical row but drop the token to prevent re-acceptance.
model ProjectShare {
  id           String              @id @default(cuid())
  projectId    String
  email        String
  // Resolved on accept. Stays null until the invitee actually
  // opens the invite URL — bare invites without a matching
  // Supabase account still surface in the share modal but have
  // no user yet.
  userId       String?
  accessLevel  ProjectAccessLevel
  // The owner's User.id at invite time. Distinct from
  // Project.userId so audit trails survive an ownership transfer
  // (a feature we don't have yet — preserves the option).
  invitedBy    String
  invitedAt    DateTime            @default(now())
  acceptedAt   DateTime?
  // Owner-revoked timestamp. Soft-delete: the row stays after
  // a revoke so the access resolver can DENY the recipient on
  // subsequent requests (otherwise a project with
  // `publicAccessLevel = "view"` would let the kicked user fall
  // through to the public-link view — user direction 2026-05-26
  // "revoked user still can access through the link"). Re-inviting
  // the same email resets `revokedAt` to null in the share-POST
  // upsert path. List queries (share modal, GET /api/projects/[id]/
  // share) filter `revokedAt: null` so revoked rows don't surface.
  revokedAt    DateTime?
  // One-time URL token. Set on creation, nulled on revoke so a
  // stale email link can't grant access after the owner kicks
  // someone out. `@unique` enforces collision-free generation.
  inviteToken  String?             @unique
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // The user who accepted the invite — null until accept. Cascade
  // on user delete so we don't keep dangling rows pointing at
  // deleted accounts (the share's email field still preserves the
  // audit trail of "X was once invited" via the email column).
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Owner can have one row per invitee — re-inviting the same
  // email upserts (changes accessLevel) rather than stacking
  // rows.
  @@unique([projectId, email])
  @@index([userId])
}

model Presentation {
  id               String                @id @default(cuid())
  projectId        String                @unique
  currentVersionId String?
  // The PresentationVersion id this project was last "saved" at —
  // the canonical pinned snapshot used to source dashboard
  // thumbnails, /projects filter data, and template exports.
  // null until the user clicks "حفظ المشروع" for the first time.
  savedVersionId   String?
  // Per-slide content snapshot taken at save time: a JSON object
  // mapping slideKey → SlideState.currentVersionNumber. Necessary
  // because per-slide restore mutates PresentationVersion.slideJson
  // IN PLACE (see lib/db/slide-versioning.ts:spliceSlideIntoActive
  // Manifest) without bumping `currentVersionId`, so the
  // saved/unsaved indicator can't rely on the PresentationVersion
  // pointer alone — it also has to compare every slide's live
  // version pointer against this snapshot. Null whenever
  // savedVersionId is null (never saved).
  savedSlideVersions Json?
  title            String
  language         String                @default("ar")
  direction        String                @default("rtl")
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  project          Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions         PresentationVersion[]
  comments         Comment[]
  slideStates      SlideState[]
}

model PresentationVersion {
  id             String       @id @default(cuid())
  presentationId String
  versionNumber  Int
  slideJson      Json
  status         String       @default("completed")
  createdAt      DateTime     @default(now())
  presentation    Presentation     @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  comments        Comment[]
  generatedImages GeneratedImage[]

  @@unique([presentationId, versionNumber])
}

// AI-generated raster images (gpt-image-2) that fill reserved
// `data-genimage` boxes in an images-mode deck (context/images.md).
// One row per box: the box's prompt + role + aspect (so Phase 4
// regenerate can amend the prompt), plus the fill status and the
// permanent public storage URL once ready. The `genid` matches the
// `data-genid` attribute on the box's <img> in the slide HTML — the
// reconcile step injects `storageUrl` as that img's `src`.
//
// Keyed to the VERSION (not the Presentation) because a full-deck
// regen creates a new PresentationVersion with a fresh set of boxes;
// the cascade drops a version's images with it.
model GeneratedImage {
  id                    String              @id @default(cuid())
  presentationVersionId String
  // Stable per-slide key (== SlideState.slideKey == slide.slideId).
  slideKey              String
  // Matches data-genid on the <img> in slide HTML; unique per version.
  genid                 String
  // The textless prompt Claude authored — amendable on regenerate.
  prompt                String
  // hero | bg | accent
  role                  String
  // landscape | portrait | square (box aspect → gpt-image-2 size)
  aspect                String
  // The size actually requested, e.g. "1536x1024". Empty until generated.
  size                  String              @default("")
  // pending | generating | ready | failed
  status                String              @default("pending")
  // Permanent public URL once ready; null while pending / on failure.
  storageUrl            String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  version               PresentationVersion @relation(fields: [presentationVersionId], references: [id], onDelete: Cascade)

  @@unique([presentationVersionId, genid])
  @@index([presentationVersionId, status])
}

// Per-slide metadata that survives across slide-content versions
// for the same logical slide (matched by `slideKey`, the stable
// id Claude assigns in the manifest). Carries the lock flag and
// the comment payload cache used by "Try again" on the per-slide
// pill.
model SlideState {
  id                   String         @id @default(cuid())
  presentationId       String
  slideKey             String
  currentVersionNumber Int            @default(1)
  // null = unlocked. When set, full-deck regen skips this slide
  // entirely (per-slide regen / undo still allowed — lock only
  // protects against bulk operations).
  lockedAt             DateTime?
  // Last-applied comment payload, JSON shape mirrors what
  // `deck-regenerate-partial` accepts. Replayed by "Try again".
  // Cleared on Lock, Regen (clean), or when fresh comments arrive.
  cachedComments       Json?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  presentation         Presentation   @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  versions             SlideVersion[]

  @@unique([presentationId, slideKey])
}

// Append-only per-slide history. Capped at 5 rows per SlideState
// (see MAX_VERSIONS_PER_SLIDE in lib/db/slide-versioning.ts) —
// oldest pruned on insert so the table can't grow unbounded even
// for heavy iteration. Locked versions are also pruneable (lock
// is a SlideState-level flag, not a version-level flag).
model SlideVersion {
  id            String     @id @default(cuid())
  slideStateId  String
  versionNumber Int
  slideJson     Json
  // create | regen | partial_regen | restore | unlock
  source        String     @default("create")
  createdAt     DateTime   @default(now())
  slideState    SlideState @relation(fields: [slideStateId], references: [id], onDelete: Cascade)

  @@unique([slideStateId, versionNumber])
  @@index([slideStateId, createdAt(sort: Desc)])
}

// Editor assistant thread (2026-10-21): what a user asked about a deck and
// what the assistant answered or proposed. A "proposal" row is a priced edit
// waiting for Confirm; applying it creates forAi comments for exactly its
// slides and runs the normal partial regen. User rows also meter the free
// daily question cap.
model AssistantMessage {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  // "user" | "assistant"
  role      String
  content   String
  // Assistant rows that propose an edit: the instruction, target slides, the
  // quoted cost, the scope bounds (area edits), and the outcome.
  proposalJson Json?
  // "proposed" | "applied" | "cancelled" (edit proposals only)
  status    String?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
}

model Comment {
  id             String              @id @default(cuid())
  presentationId String
  versionId      String
  slideId        String
  // Comment author. Set on create from the authenticated user (the
  // route looks up the prisma user via supabaseUserId). Nullable
  // because pre-existing rows from before Phase 15.B don't have an
  // author — we backfill on read by rendering "غير معروف" instead
  // of breaking the panel. New comments always have authorId set.
  authorId       String?
  areaId         String?
  elementIds     String[]
  boundsJson     Json?
  screenshotUrl  String?
  content        String
  status         String              @default("draft")
  // True when the comment is an AI instruction — created in AI mode
  // ("draw a region + tell the AI what to change"). False for normal
  // collaboration comments written for other people on the share link.
  // Only forAi comments are gathered + sent to the model on partial
  // regen (§16, Chunk 4); user comments never reach Claude.
  forAi          Boolean             @default(false)
  createdAt      DateTime            @default(now())
  presentation   Presentation        @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  version        PresentationVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  // Set onDelete: SetNull so deleting an account preserves the
  // comment's content (slide review history still readable to the
  // owner) but anonymises the author row. Same policy ProjectShare
  // uses on its userId relation.
  author         User?               @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([presentationId, versionId, status])
  @@index([slideId])
  @@index([authorId])
  @@index([versionId])
}

model Job {
  id                  String   @id @default(cuid())
  projectId           String?
  inngestRunId        String?  @unique
  type                String
  status              String   @default("queued")
  inputJson           Json?
  outputJson          Json?
  // Token-usage telemetry. Captured from Anthropic's `message.usage`
  // when the stream / non-streaming call completes. Accumulates across
  // retry attempts. Pre-credits-billing this is pure observability —
  // logs cost per flow / preset / model so the pricing structure can be
  // set from data once enhance + simulate land. Flat columns (not
  // outputJson) for cheap aggregate queries.
  model               String?
  quality             String?
  attempts            Int      @default(0)
  inputTokens         Int      @default(0)
  outputTokens        Int      @default(0)
  cacheReadTokens     Int      @default(0)
  cacheCreationTokens Int      @default(0)
  // Mid-stream cancellation signal. Set to NOW() by
  // POST /api/projects/[id]/cancel when the user clicks the
  // cancel pill in the slide-nav. The deck-generate worker polls
  // this column after every closed slide in the streaming parser —
  // if non-null, it aborts the Anthropic stream + marks the
  // version/project cancelled. Inngest's `cancelOn` event handles
  // the BETWEEN-steps cancellation; this column handles the
  // INSIDE-step (mid-stream) abort.
  cancelRequestedAt   DateTime?
  // Set when the run reaches a terminal "succeeded" state, so the admin
  // activity feed can show precise generation duration. The START of a run is
  // the moment its CreditHold was created (hold is taken at generation start,
  // after the queue), so duration = completedAt - CreditHold.createdAt.
  completedAt         DateTime?
  // The CreditHold.jobKey this run charged against, so its cost/timing can be
  // joined back. Full generations charge under jobKey === Job.id (this stays
  // null for them — the reader falls back to the id). Partial regens charge
  // under `regen:<versionId>`, which the Job otherwise can't reference, so the
  // partial-regen worker records it here.
  holdKey             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  project             Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

// A brand-only snapshot derived from a Project. Stripped of all content
// (titles, copy, logo) — keeps just palette + fonts + layout style so it
// can be re-applied to a new deck. Rendered as 4 showcase PNGs (cover /
// typography / palette / layout sample) via Puppeteer at save time.
//
// `brand` is a structured snapshot of the brand attributes; see
// `lib/template/derive-brand.ts` for the exact shape and how it's built
// from a Project's latest completed manifest.
//
// `sourceProjectId` is a non-FK pointer back to the originating Project
// for provenance ("which deck did this template come from?"). Not a true
// FK because the source project may be deleted later and we want the
// template to keep working — null-on-delete via app logic, not DB.
//
// `publishedAt` is set when isPublic flips to true (and cleared if it
// flips back). Used to order the public templates feed by recency
// independent of createdAt (a user may sit on a private template for
// weeks before publishing).
model Template {
  id              String    @id @default(cuid())
  ownerId         String
  language        String    @default("ar")
  direction       String    @default("rtl")
  slideCount      Int       @default(3)
  brand           Json      @default("{}")
  sourceProjectId String?
  // Real-deck artifacts (v2 rework): the source project's deck rendered
  // to a multi-page PDF (the "layout") plus its real per-slide
  // thumbnails. `pdfUrl` is the public Supabase URL of the stored deck
  // PDF; it is re-uploaded to the Anthropic Files API at use-time
  // (file_ids expire) to become the Mimic flow's design reference. Null
  // until the render job completes.
  pdfUrl          String?
  thumbnailUrls   String[]
  useCount        Int       @default(0)
  // `isPublic` is the single "live in the community feed" flag and is set
  // true ONLY by an admin approval (see reviewStatus). Every public-surface
  // read query keys on it, so the invariant is: isPublic === true  <=>
  // reviewStatus === APPROVED.
  isPublic        Boolean   @default(false)
  // Moderation lifecycle for a user's request to publish a template to the
  // community. PRIVATE (default): owner-only, no request outstanding.
  // PENDING: the owner asked to go public and it awaits admin review (still
  // NOT public). APPROVED: an admin approved it; isPublic flips true and it
  // goes live. A denial reverts to PRIVATE (the owner can resubmit). Every
  // pre-existing public row (isPublic = true) is backfilled to APPROVED by the
  // migration so the invariant holds on day one.
  reviewStatus    TemplateReviewStatus @default(PRIVATE)
  // Premium templates are gated to the Pro plan. Set only by the
  // platform/curator account (DB-only for now — admin console later);
  // regular users' templates stay free. Enforcement is server-side in
  // POST /api/templates/[id]/use (402 for non-owner non-Pro users).
  isPremium       Boolean   @default(false)
  // Free-plan templates (2026-10-02): the few templates a FREE user may
  // generate with (the template flow is otherwise Plus+). Curator-set (DB-only
  // for now). POST /api/projects honours it server-side by re-minting the
  // design reference itself, never trusting a client-sent file id.
  isFree          Boolean   @default(false)
  // Admin curation: manual landing/marquee order (0-based). null = not
  // featured (won't appear on the public landing marquee/grid); an int = its
  // slot in the featured ordering. Only the curator account's templates are
  // featured (admin console > Templates). The public surfaces read
  // `featuredOrder IS NOT NULL ORDER BY featuredOrder` (lib/auth/marquee-projects).
  featuredOrder   Int?
  // SEO detail page (marketing /presentation-templates/[slug]). All nullable:
  // a template gets a public detail page ONLY when the curator assigns a slug
  // in the admin console; slugless templates keep the lightbox-only behavior.
  // Names/descriptions are per-locale data (not dictionary chrome copy).
  slug            String?   @unique
  nameAr          String?
  nameEn          String?
  descriptionAr   String?
  descriptionEn   String?
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  owner           User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([isPublic, publishedAt(sort: Desc)])
  @@index([ownerId, createdAt(sort: Desc)])
  @@index([featuredOrder])
  // Admin review queue reads all PENDING rows across every user (oldest first).
  @@index([reviewStatus])
}

// Moderation state for a Template's community-publish request. See the
// reviewStatus field on Template for the full lifecycle. Kept as a small,
// closed enum so the queue query and the isPublic<=>APPROVED invariant are
// enforceable at the type level.
enum TemplateReviewStatus {
  PRIVATE
  PENDING
  APPROVED
}

model BrandKit {
  id        String   @id @default(cuid())
  userId    String
  name      String
  logo      String?
  colors    Json?
  fonts     Json?
  aiTone    String?
  assetUrls Json?
  // Marks this kit as the user's default — the four landing flows
  // (/create, /enhance, /mimic, /datasheet) auto-hydrate from the
  // default kit on first mount when no in-flight brand session
  // exists. At most one kit per user can be true.
  //
  // Invariant is enforced at the DB level by a partial unique index
  // `BrandKit_userId_default_unique` (migration
  // 20260528000127_brandkit_isdefault_partial_unique) — Postgres
  // partial unique indexes can't be expressed declaratively in
  // schema.prisma yet, so it lives in raw SQL. The API route still
  // does the two-step transaction (clear-others → flip-self) as
  // the happy-path mechanism; the partial unique index catches
  // concurrent set-default races and surfaces a Prisma P2002 error
  // the route translates into a 409 for the client.
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Reverse relation for Project.brandKitId. Configured `SetNull` on
  // delete so removing a brand kit doesn't cascade-destroy the
  // user's projects — the project's brand fields already live in
  // `aiPrompt`, the FK is just a pointer that becomes meaningless.
  projects  Project[]

  @@index([userId, isDefault])
}

model Folder {
  id        String    @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects  Project[]

  @@index([userId])
}

// One row per user, mirroring their Stripe subscription state (billing
// plan §1: Stripe owns money state, this row is a read-mirror updated
// ONLY by webhooks). `plan`/`status`/`currentPeriodEnd` are reflections,
// never authored client-side. Top-up purchases do NOT touch this row -
// they land directly as TopupGrant ledger rows.
model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  stripeCustomerId String?   @unique
  // The Stripe Subscription object id (sub_...). Null for free users
  // who only ever bought top-ups (a customer with no subscription).
  stripeSubscriptionId String? @unique
  // The active recurring Price id (price_...) - maps back to tier +
  // cadence via lib/billing/prices.ts. Null when not subscribed.
  stripePriceId    String?
  // "monthly" | "yearly" - the billing interval, mirrored from the
  // subscription's price at webhook time so the UI can show it without a
  // Stripe round-trip. Null when not subscribed.
  cadence          String?
  plan             String    @default("free")
  // active | past_due | canceled - mirrors Stripe's subscription.status
  // (narrowed). `past_due` drives the Settings dunning banner.
  status           String    @default("active")
  currentPeriodEnd DateTime?
  // Stripe's cancel_at_period_end: true after the user cancels but
  // before the period actually ends (access continues until then).
  cancelAtPeriodEnd Boolean  @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Stripe webhook idempotency ledger. Every handled event id is inserted
// here FIRST; a duplicate delivery (Stripe retries aggressively) hits
// the unique constraint and is skipped, so grants never double-apply.
// (TopupGrant.sourceKey + CreditHold.jobKey already guard the ledger
// side; this guards the whole handler so non-grant side effects - plan
// flips, status writes - are also exactly-once.)
model StripeWebhookEvent {
  id          String   @id // the Stripe event id (evt_...)
  type        String
  processedAt DateTime @default(now())
}

// ─── Credit ledger (context/subscriptionmodel.md §7, Phase 1) ───────
//
// Money model: `subscriptionBalance` is the monthly allotment bucket
// (reset to `monthlyAllotment` each cycle, NO rollover). Top-up packs
// live in their own `TopupGrant` rows because they follow different
// rules - they survive the monthly reset and expire 12 months after
// purchase. The user's spendable balance is always
//   subscriptionBalance + Σ TopupGrant.amountRemaining (unexpired)
// and is never stored denormalized anywhere else.
//
// Concurrency: every mutation locks the user's CreditAccount row
// (SELECT … FOR UPDATE) inside one transaction, so two simultaneous
// generations can never both pass the balance check (the "atomic
// consume is the only money gate" rule, §5).
model CreditAccount {
  userId              String    @id
  // Spendable remainder of the CURRENT cycle's allotment. Spent
  // before top-ups (it evaporates at reset; top-ups keep).
  subscriptionBalance Int       @default(0)
  // The tier's per-cycle grant. 0 for Free (signup grant is one-time
  // and lands in subscriptionBalance without a refill).
  monthlyAllotment    Int       @default(0)
  // Next reset boundary; mirrors Stripe current_period_end once
  // billing is live. Null for Free (nothing to reset).
  allotmentResetAt    DateTime?
  // One-time Free signup grant guard - set when the 400-credit grant
  // is issued so a re-signup / re-login can never re-grant.
  signupGrantedAt     DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One row per purchased top-up pack. Drawn down FIFO by expiry date
// (soonest-expiring first) AFTER the subscription bucket. `sourceKey`
// is the idempotency key for the grant - the Stripe event id once
// live, a sim key during testing - so a replayed webhook can't
// double-grant.
model TopupGrant {
  id              String   @id @default(cuid())
  userId          String
  amountGranted   Int
  amountRemaining Int
  expiresAt       DateTime
  sourceKey       String   @unique
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

// Hotel-style pre-authorization for one generation job. The hold
// debits the balance up-front for the maximum the job may cost; on
// completion `settle` charges the actual amount (clamped to the hold
// - the user can never pay more than they were shown) and returns the
// remainder; `release` returns everything (failure / pre-emit cancel).
//
// `jobKey` is the idempotency anchor: re-running the same job (an
// Inngest retry) finds the existing hold instead of debiting again,
// and a second settle/release is a no-op returning the first outcome.
//
// `fromSubscription` + `topupTakes` record exactly which buckets
// funded the hold so refunds flow back to the SAME sources - a refund
// must never convert expiring top-up credits into resettable
// subscription credits or vice versa.
model CreditHold {
  id               String   @id @default(cuid())
  userId           String
  jobKey           String   @unique
  amountHeld       Int
  // Final charge once settled; null while held. 0 == fully released.
  amountCharged    Int?
  // held | settled | released
  status           String   @default("held")
  fromSubscription Int      @default(0)
  // [{ grantId, amount }] - top-up draw-downs backing this hold.
  topupTakes       Json?
  // { flow, preset, slides?, estimateShown? … } for the audit trail.
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model UsageEvent {
  id        String   @id @default(cuid())
  userId    String
  eventType String
  amount    Int      @default(1)
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The credit trail + the popup's "recent usage" list both read
  // per-user newest-first.
  @@index([userId, createdAt(sort: Desc)])
}

// Flatten fidelity observatory (generate > learn > enhance). One row per LOGGED flatten on
// editor entry whose output lost content OR (Phase 1) style fidelity vs the source. Advisory
// only: it NEVER gates persistence (the content-parity net in flatten.ts still does that), it
// is the learn-loop's case store. PRIVACY: IDs + STRUCTURAL metadata only, never user content,
// drift property names + getComputedStyle VALUES (a colour / radius is structural) and a
// missing-word COUNT, never the words; the offline miner reconstructs HTML from the user's own
// slideJson stores under existing access control. fidelityScore / highDrift stay null until the
// Phase 1 style census lands; Phase 0 logs the content signal checkParity already computes.
model FlattenEvent {
  id            String   @id @default(cuid())
  userId        String
  projectId     String
  slideId       String
  // Content gate result (already computed by checkParity, today just console.warn'd)
  parityOk      Boolean
  missingCount  Int      @default(0) // COUNT of dropped visible words, NEVER the words
  // Style fidelity (Phase 1). Null until the per-leaf style census exists.
  fidelityScore Float?
  leafCount     Int      @default(0)
  highDrift     Int      @default(0)
  // Capped, redacted drift detail + denormalized generation tier (quality / flow / model) for
  // clustering without a join. No raw user HTML.
  metadata      Json?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([projectId, parityOk])
  @@index([fidelityScore]) // dashboard: scan the low-fidelity tail
  @@index([createdAt])     // standalone for the TTL sweep (mirrors Notification)
}

// Deck export activity log for the admin activity feed. One row per successful
// export, written GOING FORWARD ONLY (no backfill) — pdf/png from their server
// routes, pptx/gslides from the client via POST /api/projects/[id]/export/log.
// Attributed to the EXPORTER (resolveProjectAccess .user.prismaId): the deck
// owner for their own decks, the collaborator for a shared deck. Anonymous
// public-view exporters (no prismaId) write nothing. Exports are otherwise only
// in PostHog (deck_exported), which the console can't join per-user.
model ExportEvent {
  id         String   @id @default(cuid())
  userId     String
  projectId  String?
  // pdf | png (server routes) · pptx | gslides | gslides_fallback_pptx (client)
  format     String
  slideCount Int?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SetNull (not Cascade): the export history survives a deleted deck, since it
  // is a durable per-user activity record.
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([projectId])
}

// Phase 16.E — bell notifications.
//
// One row per "X happened that the recipient should know about." Server-
// side fan-out (`lib/notifications/server.ts`) creates rows alongside
// the realtime broadcasts that already drive live UI; the bell consumes
// rows via REST + a per-user Supabase channel.
//
// `type` is a free-form string (not an enum) because new event kinds
// will be added incrementally; an enum would force a migration each
// time. The client maps `type` → renderer + icon via a small lookup
// table in BellDropdown. Unknown types are tolerated (renderer falls
// back to a generic info row using only `payload.title` if present).
//
// `payload` JSON shape is type-specific. Examples:
//   comment.created  { slideKey, commentId, slideIds: ["s1", "s2"] }
//     (slideIds populated when grouping merges multiple events from
//      the same actor on the same project within the group window)
//   slide.regen.finished { slideKey, slideIds: [...] }
//   deck.regen.finished  {}  (no extra info — message uses projectId)
//   deck.generate.finished { versionId }
//   deck.generate.failed   { reason? }
//   share.invited     { email, accessLevel }
//   share.accepted    {}
//
// `projectId` is nullable so account-scoped events (an invite to a
// project the recipient hasn't joined yet, etc.) can still write a
// row when needed. When set, ON DELETE Cascade so wiping a project
// also drops its notifications.
//
// `actorUserId` is nullable so system-generated events (a generation
// completing isn't "caused by" a peer) can still attribute the source
// in the JOIN even if no human actor exists. Drops to SET NULL on
// user delete so the notification survives the actor's account removal
// (the recipient may still want context like "the user who shared
// this with you has left").
//
// `readAt` is set in bulk when the user opens the bell — "mark all
// read on bell open" per product decision 2026-05-24. We do NOT do
// per-row read state (a click on a row navigates, doesn't toggle
// read).
//
// Indexes:
//   • (recipientUserId, createdAt desc)  — the bell's primary list
//     query, sorted newest-first.
//   • (recipientUserId, readAt)          — unread count for the
//     badge: `count where readAt IS NULL`.
model Notification {
  id              String   @id @default(cuid())
  recipientUserId String
  // Free-form discriminator. See top-of-model comment for the active
  // type set. New types added here are reflected in the bell renderer
  // lookup; unknown types render a generic row.
  type            String
  payload         Json
  // Optional foreign key — see top-of-model comment for the nullable
  // rationale. ON DELETE Cascade so deleting a project sweeps its
  // notifications. SET NULL would orphan rows that still reference a
  // dead projectId in the payload, which the renderer can't dereference.
  projectId       String?
  // Optional foreign key — see top-of-model comment for the nullable +
  // SET NULL rationale. The actor's display name + avatar live on
  // the User row that this points to (lazily joined by the bell's
  // GET route), so deleted-actor rows render with a generic
  // "someone" placeholder instead of a broken JOIN.
  actorUserId     String?
  createdAt       DateTime @default(now())
  readAt          DateTime?

  recipient User    @relation("RecipientNotifications", fields: [recipientUserId], references: [id], onDelete: Cascade)
  actor     User?   @relation("ActorNotifications", fields: [actorUserId], references: [id], onDelete: SetNull)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, createdAt(sort: Desc)])
  @@index([recipientUserId, readAt])
  @@index([actorUserId])
  @@index([projectId])
  // Standalone createdAt index for the daily notifications-cleanup TTL sweep,
  // which range-deletes by createdAt alone (the composite above leads with
  // recipientUserId, so it can't serve that scan).
  @@index([createdAt])
}

// Admin > Broadcast: one row per platform-wide announcement sent from the admin
// console. The send ALSO writes a Notification per recipient (the bell rows);
// this standalone log is the curation-side record powering the history list +
// recipient count. Pruned after 30 days by the notifications-cleanup cron, the
// same TTL applied to bell notifications.
model AdminBroadcast {
  id             String   @id @default(cuid())
  // Bilingual: the admin authors both, and each user's bell renders the
  // version matching their UI locale (the notification payload carries both).
  titleEn        String
  messageEn      String
  titleAr        String
  messageAr      String
  recipientCount Int
  createdAt      DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}

// ─── Admin-editable runtime config (lib/config/runtime-config.ts) ──────
// Generation presets, the tier knobs, and the free-credit amount used to
// be code constants (lib/types/quality.ts, lib/anthropic/quality-params.ts,
// lib/credits/cost.ts). The admin Settings tab edits them live. Seeded from
// those constants so launch behaviour is identical; the runtime layer caches
// in-process and falls back to the same constants on a DB miss.
// `PlatformSettings.configVersion` bumps on every write so the cache reloads.

model Preset {
  key              String   @id            // "opus-fast" — matches Job.quality strings
  label            String                  // "Opus 4.8"
  model            String                  // "claude-opus-4-8" (an Anthropic model id)
  thinking         Boolean  @default(false)
  effort           String?                 // "low|medium|high|xhigh|max" — null when thinking off
  maxTokens        Int      @default(128000)
  baseCredits      Int
  perSlideCredits  Int
  secsPerSlide     Int
  baseOverheadSecs Int
  active           Boolean  @default(true)  // admin manual on/off (drives the inactive chip)
  autoInactive     Boolean  @default(false) // reserved: live-API "model missing" flag (Phase 4)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([sortOrder])
}

model Tier {
  plan               String   @id          // "free|plus|pro|max" (KnownPlan)
  priceUsd           Int                    // DISPLAY-ONLY (real price = a Stripe product)
  monthlyAllotment   Int
  signupGrant        Int                    // free.signupGrant == the FREE-credits amount
  slideCap           Int
  unlockedPresetKeys String[]               // soft refs to Preset.key
  flows              String[]               // subset of ALL_FLOWS
  sortOrder          Int      @default(0)
  updatedAt          DateTime @updatedAt
}

model PlatformSettings {
  id            String   @id @default("singleton") // single row
  configVersion Int      @default(1)                // bumped on every preset/tier write
  // Credits charged per generated image on images-mode decks (2026-07-14
  // repricing 5 -> 10: measured ~$0.053/image was ~5x above the 5-credit
  // charge). Admin-editable; live value lives in the DB row.
  imageCredits  Int      @default(10)
  // Flat base charged once per partial/slide regen run (2026-07-10 vision
  // layer repricing): every regen now runs its own render + vision review +
  // freeze bake, a per-run cost independent of slide count. Admin-editable.
  regenBaseCredits Int   @default(70)
  updatedAt     DateTime @updatedAt
}

// One-time deck unlock purchases (2026-10-08): $4.99 / $5.99 / $6.99 by deck
// size, bought by a free owner instead of a subscription. The Stripe Checkout
// Session id is the idempotency anchor (one row per paid session).
model DeckPurchase {
  id              String    @id @default(cuid())
  userId          String
  projectId       String?
  stripeSessionId String    @unique
  paymentIntentId String?
  amountCents     Int
  currency        String
  bracket         String
  createdAt       DateTime  @default(now())
  refundedAt      DateTime?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([userId])
  @@index([paymentIntentId])
}

// Anthropic token usage for calls NOT already recorded on a Job row
// (2026-11-07): PDF reading, reviews, unlocks, picture checks, the assistant.
// One row per call, written by lib/anthropic/usage-log.ts. No user content.
model LlmUsage {
  id                  String   @id @default(cuid())
  createdAt           DateTime @default(now())
  purpose             String
  model               String
  inputTokens         Int      @default(0)
  outputTokens        Int      @default(0)
  cacheReadTokens     Int      @default(0)
  cacheCreationTokens Int      @default(0)
  projectId           String?

  @@index([createdAt])
  @@index([purpose, createdAt])
}
