# Keep the Docker build context small + reproducible. Anything the image needs
# is generated inside the build (npm ci, prisma generate, next build), so local
# build artifacts + secrets must NOT be copied in.
node_modules
.next
.git
.gitignore

# Secrets / local env — never bake into the image (host injects at runtime).
.env
.env.*
!.env.example

# Local-only / scratch
.tmp-tsx
.tmp-q
docker-compose.yml
*.log
npm-debug.log*

# Editor / OS noise
.vscode
.idea
.DS_Store

# Docs + design notes — not needed at runtime
*.md
context
EnhanceEnhanced.md

# Test / CI scratch
coverage
playwright-report
test-results
